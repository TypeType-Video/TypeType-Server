DATABASE_URL=jdbc:postgresql://postgres:5432/typetype
DATABASE_USER=typetype
DATABASE_PASSWORD=typetype

DRAGONFLY_URL=redis://dragonfly:6379
DOWNLOADER_SERVICE_URL=http://typetype-downloader:18093
RECOMMENDER_SERVICE_URL=
RECOMMENDER_INTERNAL_TOKEN=
RECOMMENDER_ENABLED=false
RECOMMENDER_DEFAULT_ON=false
RECOMMENDER_REQUEST_TIMEOUT_MS=2500
RECOMMENDER_PAGE_DEADLINE_MS=4000
RECOMMENDER_STREAM_REQUESTS_PER_MINUTE=15
RECOMMENDER_STREAM_WALL_COOLDOWN_SECONDS=900
RECOMMENDER_RELATED_TTL_SECONDS=86400
RECOMMENDER_SEARCH_TTL_SECONDS=21600
RECOMMENDER_CHANNEL_TTL_SECONDS=1800
RECOMMENDER_PAGE_TTL_SECONDS=1800
RECOMMENDER_SETTINGS_TTL_SECONDS=600
RECOMMENDER_HISTORY_KEY_TTL_SECONDS=86400
RECOMMENDER_HISTORY_MAX_ITEMS=100000
RECOMMENDER_FAVORITES_MAX_ITEMS=50000
RECOMMENDER_HISTORY_CHUNK_ITEMS=20000
RECOMMENDER_PAGE_VARIANTS=3
RECOMMENDER_SOURCE_PARALLELISM=6
